+// Hash-map traversal is randomized; settle equal-priority collisions by path.
+fn choose_candidate(candidates: Vec<CandidatePath>) -> anyhow::Result<CandidatePath> {
+    candidates
+        .into_iter()
+        .min_by(|left, right| {
+            left.priority
+                .cmp(&right.priority)
+                .then_with(|| left.root.cmp(&right.root))
+                .then_with(|| left.relative.cmp(&right.relative))
+        })
+        .ok_or(anyhow!("candidate list empty"))
+}
