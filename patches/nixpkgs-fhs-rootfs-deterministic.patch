+#[cfg(test)]
+mod tests {
+    use super::{choose_candidate, CandidatePath, PriorityKey};
+    use std::path::PathBuf;
+
+    fn candidate(root: &str, priority: i64) -> CandidatePath {
+        CandidatePath {
+            root: PathBuf::from(root),
+            relative: PathBuf::from("bin/dbus-launch"),
+            priority: PriorityKey {
+                implicit: false,
+                group_priority: 1,
+                priority,
+                root_index: 0,
+            },
+        }
+    }
+
+    #[test]
+    fn equal_priority_candidates_use_a_stable_path_tiebreak() {
+        let dbus_out = candidate("/nix/store/zdbus-out", 0);
+        let dbus_lib = candidate("/nix/store/adbus-lib", 0);
+
+        for candidates in [
+            vec![dbus_out.clone(), dbus_lib.clone()],
+            vec![dbus_lib, dbus_out],
+        ] {
+            let selected = choose_candidate(candidates).expect("candidate exists");
+            assert_eq!(selected.root, PathBuf::from("/nix/store/adbus-lib"));
+        }
+    }
+
+    #[test]
+    fn priority_still_precedes_the_path_tiebreak() {
+        let preferred = candidate("/nix/store/zdbus-out", 0);
+        let lower_priority = candidate("/nix/store/adbus-lib", 1);
+
+        let selected = choose_candidate(vec![lower_priority, preferred.clone()])
+            .expect("candidate exists");
+        assert_eq!(selected.root, preferred.root);
+    }
+}
