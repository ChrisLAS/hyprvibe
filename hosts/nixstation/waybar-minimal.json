{
  "layer": "top",
  "position": "top",
  "height": 38,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["clock"],
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}"
  },
  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "<big>{0:%Y %B}</big>\n<tt><small>{calendar}</small></tt>\n\n<b>US</b>\nPacific: {0:%H:%M %Z}\n{tz_list}",
    "timezone-tooltip-format": "{0:%Z}: {0:%H:%M}",
    "timezones": [
      "America/Los_Angeles",
      "America/Denver",
      "America/New_York",
      "Europe/London",
      "UTC"
    ],
    "calendar": {
      "format": {
        "today": "<span color='#ffe86b'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down",
      "on-click-right": "mode"
    }
  }
}
